NEXT_PUBLIC_COMMUNITY_NAME="Brookhaven RP"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never NEXT_PUBLIC_
ADMIN_EMAIL_1=owner-one@gmail.com
ADMIN_EMAIL_2=owner-two@gmail.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Duplicate policy: block = reject a second open application for the same Discord ID + position; allow = accept
DUPLICATE_POLICY=block
# Email (optional). Without these, emails are skipped and the site works normally.
RESEND_API_KEY=
EMAIL_FROM="Brookhaven RP <staff@yourdomain.com>"
TEAM_NOTIFY_EMAIL=
APPLICANT_DECISION_EMAILS=false
